# No longer used: this project plans in religion/ instead. Kept so that a stray one,
# created out of habit, still cannot be committed.
PLAN.md
PROGRESS.md
LAST_MEMORY.md
NOTES_FOR_CLAUDE.md
*.handoff.md

# Build output. `template/` is what the installer ships and is regenerated by
# `npm run build`; the package copy is staged from it. The rendered adapter trees and
# entry files are committed instead, so the skills are readable in the repository and
# drift from source is caught by `npm run verify`.
/template/
packages/create-religion/template/
packages/create-religion/dist/
*.tsbuildinfo

# Dependencies
node_modules/

# OS
.DS_Store

# npm pack output
*.tgz

# Installer output, reproducible with `religion install`. The hooks here are copies of
# src/hooks/ that nothing keeps in sync, and religion/.state/ is machine-written state its
# own README says is never committed.
/.claude/hooks/
/.claude/settings.json
religion/.state/
