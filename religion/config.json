{
  "schemaVersion": 1,
  "workflow": {
    "stepReview": "item"
  },
  "git": {
    "mode": "pull-request",
    "checkpoints": "every-step",
    "featureBranchPrefix": "feature/",
    "fixBranchPrefix": "fix/",
    "rollbackBranchPrefix": "rollback/"
  },
  "verification": {
    "logicTests": "when-configured",
    "uiEvidence": "when-available"
  },
  "qualityGates": {
    "audit": "when-sensitive",
    "check": "when-behavioral"
  },
  "auto": {
    "maxItems": null,
    "maxRepairAttempts": 2,
    "finalAudit": false
  }
}
